{
  "name": "cloudra-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudra web frontend",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
