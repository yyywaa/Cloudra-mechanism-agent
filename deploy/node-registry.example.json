{
  "default_node_id": "workstation",
  "nodes": [
    {
      "node_id": "workstation",
      "display_name": "Lab Workstation",
      "state": "online",
      "capabilities": ["agent.session", "artifact.download", "compute.local"],
      "resources": {
        "max_concurrent": 2,
        "cpus": 16,
        "memory_mb": 32768
      },
      "workspaces": [
        {
          "workspace_id": "default",
          "display_name": "Cloudra Workspace",
          "path": "/srv/cloudra/workspace",
          "access": "read_write"
        }
      ]
    },
    {
      "node_id": "hpc-login",
      "display_name": "HPC Login Node (SSH)",
      "state": "online",
      "capabilities": ["agent.session", "artifact.download", "compute.slurm"],
      "resources": {
        "max_concurrent": 8,
        "cpus": 64,
        "memory_mb": 262144
      },
      "scheduler": {
        "type": "slurm",
        "partition": "compute",
        "modules": ["apps/orca/5.0.2"],
        "time_limit": "1-00:00:00",
        "poll_seconds": 30
      },
      "connection": {
        "type": "ssh",
        "host": "login.hpc.example.edu",
        "user": "cloudray",
        "port": 22,
        "identity_file": "~/.ssh/id_ed25519",
        "remote_root": "/scratch/cloudray/cloudra"
      },
      "workspaces": [
        {
          "workspace_id": "staging",
          "display_name": "HPC Staging (local dir)",
          "path": "/srv/cloudra/remote-staging/hpc",
          "access": "read_write"
        }
      ]
    },
    {
      "node_id": "workstation-b",
      "display_name": "Bare Remote Server (SSH, no Slurm)",
      "state": "online",
      "capabilities": ["agent.session", "artifact.download", "compute.local"],
      "resources": {
        "max_concurrent": 2,
        "cpus": 16,
        "memory_mb": 65536
      },
      "scheduler": {
        "type": "local"
      },
      "connection": {
        "type": "ssh",
        "host": "192.168.1.20",
        "user": "cloudray",
        "remote_root": "/home/cloudray/cloudra-jobs"
      },
      "workspaces": [
        {
          "workspace_id": "staging",
          "display_name": "Server B Staging (local dir)",
          "path": "/srv/cloudra/remote-staging/workstation-b",
          "access": "read_write"
        }
      ]
    }
  ]
}
